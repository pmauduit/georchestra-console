#!/bin/sh
set -e

if ! getent group georchestra >/dev/null; then
  if command -v addgroup >/dev/null 2>&1; then
    addgroup --system georchestra
  else
    groupadd --system georchestra
  fi
fi

if ! getent passwd georchestra >/dev/null; then
  if command -v adduser >/dev/null 2>&1; then
    adduser --system --ingroup georchestra --home /var/lib/georchestra --no-create-home --shell /usr/sbin/nologin georchestra
  else
    useradd --system --gid georchestra --home-dir /var/lib/georchestra --no-create-home --shell /usr/sbin/nologin georchestra
  fi
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
fi

exit 0
